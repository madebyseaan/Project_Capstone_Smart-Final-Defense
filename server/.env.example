# ── Core (REQUIRED) ─────────────────────────────────────────────────────
JWT_SECRET=            # 64+ hex chars: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
DATABASE_URL=          # per-school PostgreSQL instance (postgresql://user:pass@host:5432/dbname)
CSRF_SECRET=           # falls back to JWT_SECRET if not set
PORT=5003
NODE_ENV=production

# ── School-scoped (REQUIRED IN PRODUCTION — server refuses to start without these) ──
# ⚠️ Each school deployment MUST set these to ITS OWN values. Wrong values = wrong students silently synced.
ENROLLPRO_SCHOOL_YEAR_ID=      # numeric EnrollPro year id for THIS school's current year
ENROLLPRO_SCHOOL_YEAR_LABEL=   # e.g. 2026-2027 (used as fallback label when EnrollPro API is unreachable)
ATLAS_SCHOOL_ID=               # THIS school's ATLAS id (do not leave as 1)
ATLAS_SCHOOL_YEAR_ID=          # THIS school's ATLAS year id (do not leave as 3)

# ── EnrollPro connection (can also be set via Admin > System Settings — DB wins) ──
ENROLLPRO_URL=                 # e.g. https://your-school.buru-degree.ts.net/api
ENROLLPRO_ACCOUNT_NAME=
ENROLLPRO_PASSWORD=
ENROLLPRO_INTEGRATION_KEY=
ENROLLPRO_DELTA_SYNC_ENABLED=  # set to "true" to enable delta sync
ENROLLPRO_API_KEY=             # service auth key (if using service-to-service auth)

# ── ATLAS ────────────────────────────────────────────────────────────────
ATLAS_URL=                     # e.g. https://your-atlas.example.com/api/v1
ATLAS_SYSTEM_TOKEN=

# ── AIMS (optional) ─────────────────────────────────────────────────────
AIMS_URL=

# ── Sync tuning (optional) ──────────────────────────────────────────────
SYNC_CACHE_TTL_MS=300000       # default 5 minutes
SYNC_INTERVAL_MS=              # override sync interval in ms
SYNC_INTERVAL_MINUTES=         # override sync interval in minutes
SYNC_INITIAL_DELAY_MS=5000     # delay before first sync after boot
SYNC_CIRCUIT_BREAKER_FAILURE_THRESHOLD=3
SYNC_CIRCUIT_BREAKER_COOLDOWN_MS=300000
BRANDING_SYNC_EVERY_N_CYCLES=12
STUDENT_PROFILE_SYNC_EVERY_N_CYCLES=12

# ── SSOT auto-prune (optional — strict EnrollPro sync enforcement) ───────
PRUNE_ENABLED=true              # false disables the prune engine entirely
PRUNE_DRY_RUN=false             # true = plan deletions but never write
PRUNE_MAX_DELETION_RATIO=0.5    # prune ABORTS if planned deletes exceed this ratio of active entities

# ── CORS ─────────────────────────────────────────────────────────────────
CORS_ORIGIN=https://school-a.example.edu.ph

# ── Advisory workload (optional) ────────────────────────────────────────
ADVISORY_EQUIVALENT_MINUTES=   # minutes equivalent for advisory load calculation

# ── Logging (optional) ──────────────────────────────────────────────────
LOG_LEVEL=info                 # debug, info, warn, error

# ── Bootstrap (optional) ────────────────────────────────────────────────
DEFAULT_SYNC_PASSWORD=         # password for auto-created teacher accounts during sync
                               # ⚠️ UNSET = 'password123' fallback — UNACCEPTABLE for deployment
                               # The login faculty-gate mitigates risk, but set a strong value.

# ── Test credentials (CI/test only — NEVER set in production) ───────────
SMART_TEST_ADMIN_EMAIL=
SMART_TEST_ADMIN_PASSWORD=
SMART_TEST_TEACHER_EMAIL=
SMART_TEST_TEACHER_PASSWORD=
SMART_TEST_REGISTRAR_EMAIL=
SMART_TEST_REGISTRAR_PASSWORD=
