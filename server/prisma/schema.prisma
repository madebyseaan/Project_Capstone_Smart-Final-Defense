generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                 String          @id @default(cuid())
  username           String          @unique
  password           String
  role               Role
  status             UserStatus      @default(ACTIVE)
  suspendedAt        DateTime?
  suspendedBy        String?
  suspensionReason   String?
  deactivatedAt      DateTime?
  deactivatedBy      String?
  deactivationReason String?
  firstName          String?
  lastName           String?
  email              String?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  auditLogs          AuditLog[]      @relation("AuditLogUser")
  uploadedExcelForms ExcelTemplate[] @relation("ExcelTemplateUploader")
  refreshTokens      RefreshToken[]
  teacher            Teacher?
  editRequests       GradeEditRequest[] @relation("EditRequestTeacher")
  approvedRequests   GradeEditRequest[] @relation("EditRequestApprover")
  finalizedGrades    Grade[]            @relation("FinalizedGrades")
}

model Teacher {
  id               String            @id @default(cuid())
  userId           String            @unique
  employeeId       String            @unique
  specialization   String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  classAssignments ClassAssignment[]
  workloadEntries  WorkloadEntry[]
  scheduleEntries  ScheduleEntry[]
  advisorySections Section[]         @relation("SectionAdviser")
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model RefreshToken {
  id        String    @id @default(uuid())
  token     String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  familyId  String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
}

model Student {
  id              String       @id @default(cuid())
  lrn             String       @unique
  firstName       String
  middleName      String?
  lastName        String
  suffix          String?
  birthDate       DateTime?
  gender          String?
  address         String?
  guardianName    String?
  guardianContact String?
  // Extended profile fields (synced from EnrollPro)
  religion        String?
  motherTongue    String?
  barangay        String?
  city            String?
  province        String?
  fatherName      String?
  fatherContact   String?
  motherName      String?
  motherContact   String?
  ipCommunity     Boolean?      @default(false)
  is4PsBeneficiary Boolean?     @default(false)
  disability      String?
  isBalikAral     Boolean?      @default(false)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  attendance      Attendance[]
  enrollments     Enrollment[]
  grades          Grade[]

  @@index([lastName, firstName])
}

model Section {
  id               String            @id @default(cuid())
  name             String
  gradeLevel       GradeLevel
  schoolYear       String
  adviserId        String?
  program          String            @default("REGULAR") // REGULAR, SPA, SPS, STE
  status           String            @default("ACTIVE") // ACTIVE, ARCHIVED, COMPLETED
  archivedAt       DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  attendance       Attendance[]
  classAssignments ClassAssignment[]
  workloadEntries  WorkloadEntry[]
  scheduleEntries  ScheduleEntry[]
  enrollments      Enrollment[]
  adviser          Teacher?          @relation("SectionAdviser", fields: [adviserId], references: [id])

  @@unique([name, gradeLevel, schoolYear])
  @@index([gradeLevel, schoolYear])
}

model Subject {
  id                    String            @id @default(cuid())
  code                  String            @unique
  name                  String
  description           String?
  type                  SubjectType       @default(CORE)
  writtenWorkWeight     Int?
  perfTaskWeight        Int?
  quarterlyAssessWeight Int?
  isNonPromotional      Boolean           @default(false)
  // Atlas rotation metadata — null = non-rotating subject
  rotationTermGroupId   String? // e.g. "SCIENCE", "TLE_EXPLORATORY"
  rotationTermRank      Int? // 1, 2, or 3 — maps to T1, T2, T3 on SF9
  rotationOutputLabel   String? // Atlas outputLabel e.g. "SCIENCE", "TLE"
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  classAssignments      ClassAssignment[]
  scheduleEntries       ScheduleEntry[]
}

model ClassAssignment {
  id              String          @id @default(cuid())
  teacherId       String
  subjectId       String
  sectionId       String
  schoolYear      String
  teachingMinutes Int?
  isActive        Boolean         @default(true)
  archivedAt      DateTime?
  archivedReason  String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  section         Section         @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  subject         Subject         @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacher         Teacher         @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  grades          Grade[]
  workloadEntries WorkloadEntry[]

  @@unique([teacherId, subjectId, sectionId, schoolYear])
  @@index([schoolYear])
  @@index([teacherId])
  @@index([sectionId])
  @@index([subjectId])
}

model ScheduleEntry {
  id         String   @id @default(cuid())
  teacherId  String
  subjectId  String
  sectionId  String
  schoolYear String
  termIndex  Int?     // ATLAS term membership (1, 2, or 3) — durable schedule truth
  day        String
  startTime  String
  endTime    String
  roomId     Int?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  teacher    Teacher  @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  subject    Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  section    Section  @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@unique([teacherId, subjectId, sectionId, schoolYear, day, startTime])
  @@index([teacherId, schoolYear])
  @@index([sectionId])
}

model Enrollment {
  id             String           @id @default(cuid())
  studentId      String
  sectionId      String
  schoolYear     String
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  status         EnrollmentStatus @default(ENROLLED)
  isArchived     Boolean          @default(false)
  archivedAt     DateTime?
  archivedReason String?
  dropOutDate    DateTime?
  transferOutDate DateTime?
  dropOutReason  String?
  profileSnapshot Json?            // Student profile snapshot at enrollment time (immutable)
  promotionStatus      PromotionStatus?
  promotedToGradeLevel GradeLevel?
  section        Section          @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  student        Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  remedialClasses RemedialClass[]

  @@unique([studentId, sectionId, schoolYear])
  @@index([schoolYear, status])
  @@index([sectionId, schoolYear, status])
  @@index([studentId, schoolYear])
}

model Grade {
  id                    String          @id @default(cuid())
  studentId             String
  classAssignmentId     String
  term                  Term
  writtenWorkScores     Json?
  perfTaskScores        Json?
  quarterlyAssessScore  Float?
  quarterlyAssessMax    Float?          @default(100)
  qaDescription         String?
  qaDate                String?
  writtenWorkPS         Float?
  perfTaskPS            Float?
  quarterlyAssessPS     Float?
  initialGrade          Float?
  quarterlyGrade        Float?
  remarks               String?
  qualitativeDescriptor String?
  isArchived            Boolean         @default(false)
  archivedAt            DateTime?
  archivedReason        String?
  status                GradeStatus     @default(DRAFT)
  finalizedBy           String?
  finalizedAt           DateTime?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt
  classAssignment       ClassAssignment @relation(fields: [classAssignmentId], references: [id], onDelete: Cascade)
  student               Student         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  finalizedByUser       User?           @relation("FinalizedGrades", fields: [finalizedBy], references: [id])

  @@unique([studentId, classAssignmentId, term])
  @@index([studentId])
  @@index([classAssignmentId])
  @@index([status])
}

model GradeSnapshot {
  id                String   @id @default(cuid())
  gradeId           String?
  studentId         String
  classAssignmentId String
  teacherId         String
  subjectCode       String
  subjectName       String
  sectionId         String
  sectionName       String
  schoolYear        String
  term              Term
  snapshot          Json
  createdAt         DateTime @default(now())

  @@index([studentId, classAssignmentId, term])
  @@index([classAssignmentId, term])
  @@index([teacherId, createdAt])
  @@index([gradeId])
}

model Attendance {
  id         String           @id @default(cuid())
  studentId  String
  sectionId  String
  date       DateTime         @db.Date
  status     AttendanceStatus @default(PRESENT)
  remarks    String?
  recordedBy String?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  section    Section          @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  student    Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, sectionId, date])
  @@index([sectionId, date])
  @@index([studentId])
  @@index([date])
}

model WorkloadEntry {
  id                String           @id @default(cuid())
  teacherId         String
  sectionId         String?
  classAssignmentId String?
  schoolYear        String
  type              WorkloadType
  minutes           Int
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  teacher           Teacher          @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  section           Section?         @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  classAssignment   ClassAssignment? @relation(fields: [classAssignmentId], references: [id], onDelete: Cascade)

  @@unique([teacherId, sectionId, schoolYear, type])
  @@index([teacherId, schoolYear])
  @@index([type, schoolYear])
  @@index([sectionId])
}

model AuditLog {
  id         String        @id @default(cuid())
  action     AuditAction
  userId     String?
  userName   String
  userRole   String
  target     String
  targetType String
  targetId   String?
  details    String
  ipAddress  String?
  severity   AuditSeverity @default(INFO)
  metadata   Json?
  createdAt  DateTime      @default(now())
  user       User?         @relation("AuditLogUser", fields: [userId], references: [id])

  @@index([createdAt])
  @@index([userId])
  @@index([action])
  @@index([targetType])
}

model SyncHistory {
  id          String   @id @default(cuid())
  source      String
  status      String
  durationMs  Int
  startedAt   DateTime
  completedAt DateTime
  enrollpro   Json?
  atlas       Json?
  branding    Boolean  @default(false)
  error       String?
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([status])
  @@index([source])
}

model SchoolYear {
  id         String    @id @default(cuid())
  label      String    @unique // "2026-2027"
  externalId Int?      @unique  // EnrollPro numeric ID — primary align key
  status     String    @default("ACTIVE") // DRAFT, ACTIVE, ARCHIVED, COMPLETED
  termLabelT1 String   @default("Quarterly 1") // configurable display label for T1
  termLabelT2 String   @default("Quarterly 2") // configurable display label for T2
  termLabelT3 String   @default("Quarterly 3") // configurable display label for T3
  startDate  DateTime?
  endDate    DateTime?
  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  // Reverse relation: which SystemSettings points to this year
  systemSettings SystemSettings[]
  yearGradeLock  YearGradeLock?
  termGradeLocks TermGradeLock[]
}

model YearGradeLock {
  id           String     @id @default(cuid())
  schoolYearId String     @unique
  isLocked     Boolean    @default(false)
  lockedBy     String?
  lockedAt     DateTime?
  unlockedBy   String?
  unlockedAt   DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  schoolYear   SchoolYear @relation(fields: [schoolYearId], references: [id], onDelete: Cascade)
}

model TermGradeLock {
  id           String     @id @default(cuid())
  schoolYearId String
  term         Term
  isLocked     Boolean    @default(false)
  lockedBy     String?
  lockedAt     DateTime?
  unlockedBy   String?
  unlockedAt   DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  schoolYear   SchoolYear @relation(fields: [schoolYearId], references: [id], onDelete: Cascade)

  @@unique([schoolYearId, term])
}

model SystemSettings {
  id                 String    @id @default("main")
  schoolName         String    @default("Sample High School")
  schoolId           String    @default("123456")
  division           String    @default("Division of Sample City")
  region             String    @default("Region IV-A CALABARZON")
  address            String?
  contactNumber      String?
  email              String?
  currentSchoolYear  String    @default("2025-2026")
  schoolYearId       String?   // FK to SchoolYear — prefer reading from here
  schoolYear         SchoolYear? @relation(fields: [schoolYearId], references: [id], onDelete: SetNull)
  currentTerm        Term      @default(T1)
  logoUrl            String?
  primaryColor       String    @default("#6366f1")
  secondaryColor     String    @default("#8b5cf6")
  accentColor        String    @default("#06b6d4")
  sessionTimeout     Int       @default(30)
  maxLoginAttempts   Int       @default(5)
  passwordMinLength  Int       @default(8)
  requireSpecialChar Boolean   @default(true)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  autoAdvanceTerm    Boolean   @default(false)
  t1EndDate          DateTime?
  t1StartDate        DateTime?
  t2EndDate          DateTime?
  t2StartDate        DateTime?
  t3EndDate          DateTime?
  t3StartDate        DateTime?
  lastEnrollProSync  DateTime?
  gradeLock          Boolean   @default(false)  // When true, teachers cannot edit grades (EOSY lock)
  transitionLock     Boolean   @default(false)  // When true, teachers cannot log in (year transition window)
  transitionNote     String?
  auditLogRetentionDays      Int       @default(365)
  syncHistoryRetentionDays   Int       @default(90)
  gradeSnapshotRetentionDays Int       @default(0)  // 0 = disabled (DepEd policy TBD)

  // EnrollPro credentials (dynamic — admin can update without restart)
  enrollproUrl             String?
  enrollproAccountName     String?
  enrollproPassword        String?   // stored as-is, not encrypted (same as .env)
  enrollproIntegrationKey  String?
}

model GradingConfig {
  id                    String      @id @default(cuid())
  subjectType           SubjectType @unique
  writtenWorkWeight     Int
  performanceTaskWeight Int
  quarterlyAssessWeight Int
  isDepEdDefault        Boolean     @default(true)
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt
}

model TransmutationEntry {
  id              String   @id @default(cuid())
  minGrade        Float
  maxGrade        Float
  transmutedGrade Int
  isDefault       Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([minGrade])
}

model ExcelTemplate {
  id             String   @id @default(cuid())
  formType       FormType @unique
  formName       String
  description    String?
  filePath       String
  fileName       String
  fileSize       Int
  placeholders   Json?
  instructions   String?
  isActive       Boolean  @default(true)
  uploadedBy     String
  uploadedByName String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  sheetName      String?
  uploader       User     @relation("ExcelTemplateUploader", fields: [uploadedBy], references: [id])

  @@index([formType])
  @@index([isActive])
  @@index([filePath])
}

enum Role {
  TEACHER
  ADMIN
  REGISTRAR
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

enum GradeStatus {
  DRAFT
  FINALIZED
  LOCKED
}

enum Term {
  T1
  T2
  T3
}

enum GradeLevel {
  GRADE_7
  GRADE_8
  GRADE_9
  GRADE_10
}

enum SubjectType {
  CORE
  MAPEH
  TLE
  MATH_SCIENCE
}

enum WorkloadType {
  ADVISORY_ROLE
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

enum EnrollmentStatus {
  ENROLLED
  PENDING
  DROPPED
  TRANSFERRED
}

enum PromotionStatus {
  PROMOTED
  CONDITIONALLY_PROMOTED
  RETAINED
  JHS_COMPLETER
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  CONFIG
}

enum AuditSeverity {
  INFO
  WARNING
  CRITICAL
}

enum FormType {
  SF1
  SF2
  SF3
  SF4
  SF5
  SF6
  SF8
  SF9
  SF10
  SF7
}

model RemedialClass {
  id              String    @id @default(cuid())
  enrollmentId    String
  schoolYear      String
  gradeLevel      GradeLevel

  subjectCode     String
  subjectName     String
  originalGrade   Float

  remedialMark    Float?
  recomputedGrade Float?
  outcome         String?

  conductedFrom   DateTime?
  conductedTo     DateTime?

  status          String    @default("PENDING")

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  enrollment      Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

  @@unique([enrollmentId, subjectCode])
  @@index([status])
  @@index([schoolYear])
}

model GradeEditRequest {
  id           String            @id @default(cuid())
  teacherId    String
  teacherName  String
  term         String
  schoolYear   String
  gradeLevel   String?
  section      String?
  subject      String?
  classAssignmentId String?
  reason       String
  status       EditRequestStatus @default(PENDING)
  approvedById String?
  approvedByName String?
  expiresAt    DateTime?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  teacher      User?             @relation("EditRequestTeacher", fields: [teacherId], references: [id])
  approver     User?             @relation("EditRequestApprover", fields: [approvedById], references: [id])

  @@index([status])
  @@index([teacherId])
  @@index([createdAt])
}

enum EditRequestStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
}
